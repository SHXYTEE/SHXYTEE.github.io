{ tag: tag } := import('tag')
{ attr: attr } := import('attr')
{ cls: cls } := import('cls')

{ divider: divider } := import('divider')

{ render: layout } := import('layout')

// ---

fn render(root) with layout(root) :div |> tag(
    cls(:about, :container)
    tag(:h1, 'ABOUT YXXS')
    :p |> tag(
        'YXXS is YE mobile-first news platform. '
        'Designed for quick, high-signal news consumption on phones.'
    )
    :p |> tag(
        'Stories are paired with William Blake artwork '
        'for thematic resonance and visionary context.'
    )
    :p |> tag(
        'Navigate via the news feed '
        divider()
        'or browse posts for full articles.'
    )
)
