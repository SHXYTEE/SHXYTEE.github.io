std := import('std')
fs := import('fs')
str := import('str')

{ RootVm: RootVm } := import('RootVm')

{ TOML: TOML } := import('data')

sort := import('sort')
datetime := import('datetime')

{ s: s } := import('s')

{ id: id } := import('id')
{ tag: tag } := import('tag')
{ cls: cls } := import('cls')
{ attr: attr } := import('attr')

{ divider: divider } := import('divider')

{ link: link, hashLink: hashLink } := import('link')

{ render: layout } := import('layout')

// ---

// Parse a post's date (YYYY-MM-DD) into a unix timestamp for sorting.
fn postDate(idx) if ? = idx | idx.date = ? {
    true -> 0
    _ -> if parsed := datetime.parse(idx.date + 'T00:00:00Z') {
        ? -> 0
        _ -> datetime.timestamp(parsed)
    }
}

fn getTomls(dir) vfs.listDir(dir) |>
    std.filter(fn(e) !e.dir & str.endsWith?(e.name, '.toml')) |>
    std.map(fn(e) std.slice(e.name, 0, len(e.name) - 5))

// fn sortTomls(tx, fx) with sort.sort(tx) fn(p) -with postDate() fx(p)
fn sortTomls(tx, fx) sort.sort(tx) |> std.reverse()

// ---

fn byId(id) vfs.readFile('yix/posts/' + id + '.toml', TOML.parse)
fn listPosts(dir) getTomls(dir) |> sortTomls(byId)

fn updateCache PostsCache <- listPosts('yix/posts')
PostsCache := updateCache()

PostsDict := with std.reduce(PostsCache, {}) fn(acc, p) acc.(p) <- byId(p)
fn getPost(id) PostsDict.(id) |> std.default({ title: 'NOT FOUND', date: '', body: '', viewMBC: ?, infoMBC: ? })

PostInterval := window.setInterval(updateCache, 15000)

// ---

fn item(root, post) {
    // info := byId(post)
    info := getPost(post)
    
    ix := :li |> tag(
        ixLink := hashLink(info.title, 'posts/' + post)
        ixDivider := divider()
        info.date
    )

    if info.infoMBC != ? -> with RootVm(info.infoMBC, root) {
        post: post
        info: info
        ix: ix
        ixLink: ixLink
        ixDivider: ixDivider
        ixDate: info.date
    }
    
    ix
}

// ---

fn render(root) with layout(root) :div |> tag(
    cls(:posts, :container)
    tag(:h1, 'POSTS')
    
    with tag(:ul) fn
    (ul) with std.each(PostsCache) fn
    (p) with ul.appendChild() item(root, p)
)
